#!/usr/bin/env python3
import sys
import os

sys.path.insert(0, '/usr/share/ultron-workflow')

from workflow_engine import WorkflowEngine, ContextAwareSuggestions

def main():
    if len(sys.argv) < 2:
        print('Usage: ultron-workflow {list|run|create|suggestions}')
        print()
        print('Commands:')
        print('  list              - List all workflows')
        print('  run <id>          - Execute a workflow')
        print('  create            - Create a new workflow')
        print('  suggestions       - Get context-aware suggestions')
        sys.exit(1)
    
    command = sys.argv[1]
    
    if command == 'list':
        engine = WorkflowEngine()
        workflows = engine.workflows
        
        if not workflows:
            print('No workflows configured')
        else:
            print('=== Workflows ===')
            for wf in workflows:
                status = '✓' if wf['enabled'] else '✗'
                print(f'{status} [{wf["id"]}] {wf["name"]}')
                print(f'   Trigger: {wf["trigger"]["type"]}')
                print(f'   Actions: {len(wf["actions"])}')
                print(f'   Last triggered: {wf["last_triggered"] or "Never"}')
                print()
    
    elif command == 'run':
        if len(sys.argv) < 3:
            print('Usage: ultron-workflow run <id>')
            sys.exit(1)
        
        workflow_id = int(sys.argv[2])
        engine = WorkflowEngine()
        result = engine.execute_workflow(workflow_id)
        
        if result['success']:
            print('Workflow executed successfully')
            for r in result['results']:
                print(f'  ✓ {r.get("message", "OK")}')
        else:
            print(f'Workflow failed: {result["message"]}')
    
    elif command == 'create':
        print('Workflow creation interactive mode')
        # This would be an interactive wizard
        pass
    
    elif command == 'suggestions':
        suggestions = ContextAwareSuggestions()
        results = suggestions.get_suggestions()
        
        if not results:
            print('No suggestions at this time')
        else:
            print('=== Suggestions ===')
            for s in results:
                print(f'[{s["type"]}] {s["text"]}')
                print(f'   Confidence: {s["confidence"]:.0%}')
                print()
    
    else:
        print(f'Unknown command: {command}')
        sys.exit(1)

if __name__ == '__main__':
    main()
