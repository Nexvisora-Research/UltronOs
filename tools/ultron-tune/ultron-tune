#!/usr/bin/env python3
import sys
import os

sys.path.insert(0, '/usr/share/ultron-tune')

from performance_tuner import PerformanceTuner

def main():
    tuner = PerformanceTuner()
    
    if len(sys.argv) < 2:
        print('Usage: ultron-tune {analyze|optimize|reset}')
        print()
        print('Commands:')
        print('  analyze    - Analyze current system performance')
        print('  optimize   - Apply all performance optimizations')
        print('  reset      - Reset to default settings')
        sys.exit(1)
    
    command = sys.argv[1]
    
    if command == 'analyze':
        status = tuner.analyze_system()
        print('=== System Performance Analysis ===')
        print(f'Boot time services: {len(status["boot_time"])}')
        print(f'Memory usage: {status["memory_usage"]["percent"]}%')
        print(f'Swap usage: {status["swap_usage"]["percent"]}%')
        print(f'Running services: {len(status["running_services"])}')
        print(f'Startup apps: {len(status["startup_apps"])}')
    
    elif command == 'optimize':
        print('Applying performance optimizations...')
        results = tuner.apply_all_optimizations()
        for category, items in results.items():
            print(f'\n{category.upper()}:')
            for item in items:
                print(f'  ✓ {item}')
    
    elif command == 'reset':
        print('Resetting to defaults...')
        results = tuner.reset_to_defaults()
        for item in results:
            print(f'  ✓ {item}')
    
    else:
        print(f'Unknown command: {command}')
        sys.exit(1)

if __name__ == '__main__':
    main()
